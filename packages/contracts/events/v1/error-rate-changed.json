{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deploysentinel.dev/schemas/events/v1/error-rate-changed.json",
  "title": "ErrorRateChanged",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "organizationId",
    "serviceId",
    "environment",
    "occurredAt",
    "receivedAt",
    "correlationId",
    "payload"
  ],
  "properties": {
    "eventId": { "type": "string" },
    "eventType": { "type": "string", "const": "ErrorRateChanged" },
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "organizationId": { "type": "string" },
    "serviceId": { "type": "string" },
    "environment": { "type": "string" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "receivedAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string" },
    "payload": {
      "type": "object",
      "required": ["errorRatePercent", "windowMinutes"],
      "properties": {
        "errorRatePercent": { "type": "number" },
        "previousRatePercent": { "type": "number" },
        "windowMinutes": { "type": "number" },
        "totalRequests": { "type": "number" },
        "failedRequests": { "type": "number" }
      }
    }
  }
}
