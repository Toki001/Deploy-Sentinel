# DeploySentinel Environment Variables

# Node environment: development | test | production
NODE_ENV=development

# API Service
PORT=4000
HOST=0.0.0.0
DEV_AUTH_BYPASS=true

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/deploysentinel

# Event Backbone (Redpanda / Kafka)
REDPANDA_BROKERS=localhost:9092

# Telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=info

# Ingress Webhook Signing Secret
WEBHOOK_DEFAULT_SECRET=dev_webhook_signing_secret_32bytes!

# AI Provider: offline | gemini
AI_PROVIDER=offline
# Optional Gemini API key (kept empty to prevent unintended cloud billing)
# GEMINI_API_KEY=
