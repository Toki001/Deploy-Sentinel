  "panels": [
    {
      "title": "AI Investigation Duration (p50, p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, sum(rate(deploysentinel_investigation_duration_ms_bucket[5m])) by (le))",
          "legendFormat": "p50 duration (ms)"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(deploysentinel_investigation_duration_ms_bucket[5m])) by (le))",
          "legendFormat": "p95 duration (ms)"
        }
      ]
    },
    {
      "title": "Diagnostic Tool Executions",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(deploysentinel_investigation_tool_calls_total[5m]))",
          "legendFormat": "Tool calls / sec"
        }
      ]
    },
    {
      "title": "Investigation Token Consumption",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(deploysentinel_investigation_tokens_total[5m])) by (type)",
          "legendFormat": "{{type}} tokens"
        }
      ]
    },
    {
      "title": "Cumulative AI Cost (USD)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "deploysentinel_investigation_cost_usd",
          "legendFormat": "Cost ($)"
        }
      ]
    }
  ],
